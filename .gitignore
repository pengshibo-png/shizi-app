node_modules/
dist/
build/
.DS_Store
*.log

# 生成产物（可从脚本重建）
packages/content/assets/audio/
packages/content/assets/fonts/*.ttf

# 上游原始抓取件默认不入库（52MB 字典等），但一级字表只有 13.7 KB 且是
# 《通用规范汉字表》原文，是字表构建的必要输入 —— 必须随仓库分发，
# 否则别人克隆后跑 `pnpm content:chars` 会直接失败。
# 注意：要放行目录内的单个文件，父目录本身不能被忽略，所以这里用 /* 而不是 /
packages/content/data/cache/*
!packages/content/data/cache/level-1.txt

# Capacitor / Android 构建产物
apps/*/android/.gradle/
apps/*/android/app/build/
apps/*/android/build/
apps/*/android/local.properties

# 同步服务数据
services/sync/data/

.env
.env.local

# ---------------------------------------------------------------------------
# 签名：仓库里不含任何密钥、口令或密钥库文件。
# 本地开发用 android/keystore.properties（见 keystore.properties.example）。
# ---------------------------------------------------------------------------
*.keystore
*.jks
keystore.properties

# ---------------------------------------------------------------------------
# 构建产物
# APK 单个 176MB，超过 GitHub 100MB 硬限制（推上去会被拒），且可从源码重建。
# ---------------------------------------------------------------------------
dist-apk/

# 原始字体源文件 24.7MB（OFL-1.1，由 scripts/fetch-font 流程下载）。
# 实际打包用的子集 wenkai-subset.woff2（808KB）已入库，克隆后无需再取源字体。
packages/content/fonts-src/
